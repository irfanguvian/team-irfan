# Generated by bin/init.sh from the operator's live ~/.claude. Machine-specific,
# contains a plaintext OAuth copy — never committed, delete when the run is done.
configs/

# Run artifacts: transcripts, diffs, and logs quote the agent's output verbatim.
# The durable record is results/results.csv and the judgments, which stay.
runs/

# pricing.json is copied from harness-v3 by init.sh
pricing.json
